#!/bin/sh
# Block direct pushes to main; use a branch + Pull Request.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "BLOCKED: direct push to main is not allowed. Push a feature/ branch and open a PR." >&2
    exit 1
  fi
done
exit 0